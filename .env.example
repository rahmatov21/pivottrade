# PivotTrader Pro Configuration Template
# Duplicate this file to .env and insert your real credentials

# Telegram Remote Bot Credentials (from @BotFather & @userinfobot)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_ADMIN_ID="YOUR_TELEGRAM_ADMIN_ID"

# MEXC Global Market Feed & Account API (from https://www.mexc.com/user/openapi)
EXCHANGE="MEXC"
MEXC_API_KEY="YOUR_MEXC_API_KEY"
MEXC_SECRET_KEY="YOUR_MEXC_SECRET_KEY"

# Trading Pair & Strategy Parameters
SYMBOL="BTCUSDT"
TIMEFRAME="15m"
PIVOT_LENGTH="10"
RISK_REWARD_RATIO="1.5"
SL_BUFFER_PCT="0.002"
INITIAL_POSITION_SIZE_PCT="0.75"
DIP_POSITION_SIZE_PCT="0.25"
DIP_TRIGGER_PCT="0.015"
